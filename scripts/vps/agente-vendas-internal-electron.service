[Unit]
Description=Agente de Vendas - Navegador Electron Persistente
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agentevendas
Group=agentevendas
Environment=HOME=/var/lib/agente-vendas-local
Environment=ELECTRON_DISABLE_SECURITY_WARNINGS=true
ExecStart=/usr/bin/xvfb-run --auto-servernum "--server-args=-screen 0 1280x900x24" /opt/agente-vendas-local/runtime/node_modules/.bin/electron --no-sandbox --remote-debugging-address=127.0.0.1 --remote-debugging-port=9223 --user-data-dir=/var/lib/agente-vendas-local/internal-electron-profile /opt/agente-vendas-local/app/scripts/vps/internal_electron_browser.cjs
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/agente-vendas-local

[Install]
WantedBy=multi-user.target
