# Configuração local do Agente de Vendas Local.
# Copie para `.env` somente se precisar alterar os padrões. Nunca versione o `.env`.

# Ollama local (não use APIs online por padrão)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:0.6b

# BrowserOS neo via MCP HTTP local
BROWSEROS_MCP_URL=http://127.0.0.1:9200/mcp
# Opcional: caminhos explícitos do servidor e da configuração do BrowserOS
# BROWSEROS_SERVER=C:\Users\SEU_USUARIO\AppData\Local\BrowserClaw\Application\155.0.8318.26\BrowserClawServer\default\resources\bin\browseros-claw-server.exe
# BROWSEROS_CONFIG=C:\Users\SEU_USUARIO\AppData\Local\BrowserClaw\User Data\.browseros\config.json
# OLLAMA_EXE=C:\Users\SEU_USUARIO\AppData\Local\Programs\Ollama\ollama.exe

# REA MCP opcional. Quando vazio, a aplicação usa apenas a análise local de evidências.
REA_MCP_URL=

# Persona comercial: consultivo | conciso
SALES_PERSONA=consultivo
SALES_PRODUCT_NAME=nossa solução

# Limites de segurança e desempenho
SALES_MAX_PAGE_CHARS=12000
SALES_HTTP_TIMEOUT=60

# Diretório de dados. Em desenvolvimento, o padrão é a raiz do projeto.
# Quando empacotado, o padrão é %LOCALAPPDATA%\SalesAgentLocal.
# SALES_AGENT_DATA_DIR=
# SALES_AGENT_DB=

# CRM comercial do ERP ClinicaTEA (opcional; nunca versione o valor real)
ERP_CLINICATEA_API_BASE_URL=https://api.erpclinicatea.com
ERP_CLINICATEA_API_TOKEN=
ERP_CLINICATEA_API_TIMEOUT=30

# Instagram/Meta Graph API — somente para testar a conexão da conta
INSTAGRAM_TARGET_USERNAME=erpclinicatea
INSTAGRAM_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
META_GRAPH_VERSION=v23.0
META_PROVIDER=direct
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
META_REDIRECT_URI=http://127.0.0.1:8765/meta/callback
POSTFLOW_BASE_URL=https://postflow.avanthcode.com
# Use a sessão/API já autenticada do PostFlow. Nunca cole tokens no código.
POSTFLOW_API_TOKEN=
POSTFLOW_SESSION_COOKIE=
POSTFLOW_TIMEOUT=20
# Somente na mesma VPS e apenas quando o PostFlow estiver em loopback.
# POSTFLOW_BASE_URL=http://127.0.0.1:3110
# POSTFLOW_TRUSTED_LOCAL=true
# POSTFLOW_SYNC_ENABLED=true
# POSTFLOW_SYNC_INTERVAL_SECONDS=90
